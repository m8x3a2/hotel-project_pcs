# Пример корневого .env для КР3 (без настоящих секретов).
# Настоящий .env создаёт backend\init-env.ps1 (его вызывает start-compose.ps1),
# либо скопируйте этот файл в .env и замените значения "укажите_...".
# .env в git не коммитится.

POSTGRES_DB=hotel_booking
POSTGRES_USER=hotel_app
POSTGRES_PASSWORD=укажите_свой_пароль

JWT_SECRET_BASE64=укажите_случайный_base64_секрет_не_короче_32_байт
JWT_ISSUER=hotel-booking
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ADMIN_EMAIL=admin@hotel.local
BOOTSTRAP_ADMIN_NAME=Hotel Administrator
BOOTSTRAP_ADMIN_PASSWORD=укажите_временный_пароль_12+_символов_Aa1!

CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=true
APP_PORT=8080
POSTGRES_PORT=15432
