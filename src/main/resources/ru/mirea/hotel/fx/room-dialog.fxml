<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<!-- Форма номера гостиницы -->
<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.hotel.fx.controller.RoomDialogController"
            stylesheets="@app.css" prefWidth="480">
    <headerText>Данные номера. Все поля обязательны.</headerText>
    <content>
        <GridPane hgap="10" vgap="10" styleClass="form">
            <columnConstraints>
                <ColumnConstraints minWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Номер комнаты:" GridPane.rowIndex="0"/>
            <TextField fx:id="numberField" promptText="например, 105"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Тип номера:" GridPane.rowIndex="1"/>
            <ComboBox fx:id="typeBox" promptText="выберите тип" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Вместимость:" GridPane.rowIndex="2"/>
            <TextField fx:id="capacityField" promptText="от 1 до 6 человек"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Цена за ночь, руб.:" GridPane.rowIndex="3"/>
            <TextField fx:id="priceField" promptText="например, 3500"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"
                   GridPane.rowIndex="4" GridPane.columnSpan="2"/>
        </GridPane>
    </content>
</DialogPane>
