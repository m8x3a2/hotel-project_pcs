<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Вкладка "Бронирования". onAction="#onAdd" - при нажатии вызывается метод onAdd() контроллера -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.hotel.fx.controller.BookingsController"
            styleClass="tab-content">
    <top>
        <VBox spacing="10" styleClass="top-box">
            <!-- Кнопки действий -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
                <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
                <Button fx:id="statusButton" text="Сменить статус" onAction="#onChangeStatus"/>
                <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Обновить" onAction="#onRefresh"/>
                <Button text="Экспорт в Excel" onAction="#onExport"/>
            </HBox>

            <!-- Поиск, фильтры и сортировка. FlowPane переносит элементы на новую строку, если окно узкое -->
            <FlowPane hgap="8" vgap="8" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="Поиск: ФИО гостя или номер комнаты" prefWidth="250"/>
                <!-- promptText показывается, когда ничего не выбрано (значение null) - это и есть "все" -->
                <ComboBox fx:id="statusFilter" promptText="Все статусы" prefWidth="150"/>
                <ComboBox fx:id="typeFilter" promptText="Все типы" prefWidth="120"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Заезд с"/>
                    <DatePicker fx:id="fromPicker" prefWidth="130" editable="false"/>
                    <Label text="по"/>
                    <DatePicker fx:id="toPicker" prefWidth="130" editable="false"/>
                </HBox>
                <Button text="Сбросить фильтры" onAction="#onResetFilters"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Сортировка:"/>
                    <ComboBox fx:id="sortBox" promptText="клик по заголовку столбца" prefWidth="230"/>
                </HBox>
            </FlowPane>
        </VBox>
    </top>

    <center>
        <!-- Таблица. PropertyValueFactory property="guestName" берёт значение из метода getGuestName() -->
        <TableView fx:id="table">
            <placeholder>
                <Label text="Бронирований не найдено" styleClass="muted"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="№" prefWidth="50">
                    <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="guestColumn" text="Гость" prefWidth="230">
                    <cellValueFactory><PropertyValueFactory property="guestName"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Номер" prefWidth="70">
                    <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Тип номера" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="roomType"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="checkInColumn" text="Заезд" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="checkIn"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="checkOutColumn" text="Выезд" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="checkOut"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Ночей" prefWidth="65">
                    <cellValueFactory><PropertyValueFactory property="nights"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Гостей" prefWidth="65">
                    <cellValueFactory><PropertyValueFactory property="guestsCount"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Статус" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="priceColumn" text="Стоимость" prefWidth="130">
                    <cellValueFactory><PropertyValueFactory property="totalPrice"/></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="6" styleClass="details-box">
            <Label fx:id="countLabel" styleClass="muted"/>
            <Label text="Связанные данные (гость и номер)" styleClass="section-title"/>
            <Label fx:id="detailsLabel" wrapText="true"/>
        </VBox>
    </bottom>
</BorderPane>
