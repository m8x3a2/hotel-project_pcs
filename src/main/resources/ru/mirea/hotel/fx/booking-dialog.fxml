<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<!-- Форма бронирования. Гость и номер выбираются из списков (ComboBox), даты - из календаря (DatePicker) -->
<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.hotel.fx.controller.BookingDialogController"
            stylesheets="@app.css" prefWidth="600">
    <headerText>Бронирование номера. Стоимость рассчитывается автоматически.</headerText>
    <content>
        <GridPane hgap="10" vgap="10" styleClass="form">
            <columnConstraints>
                <ColumnConstraints minWidth="140"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Гость:" GridPane.rowIndex="0"/>
            <ComboBox fx:id="guestBox" promptText="выберите гостя" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Номер:" GridPane.rowIndex="1"/>
            <ComboBox fx:id="roomBox" promptText="выберите номер" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Дата заезда:" GridPane.rowIndex="2"/>
            <DatePicker fx:id="checkInPicker" editable="false" maxWidth="Infinity"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Дата выезда:" GridPane.rowIndex="3"/>
            <DatePicker fx:id="checkOutPicker" editable="false" maxWidth="Infinity"
                        GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Количество гостей:" GridPane.rowIndex="4"/>
            <TextField fx:id="guestsField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label fx:id="priceLabel" styleClass="price-label"
                   GridPane.rowIndex="5" GridPane.columnSpan="2"/>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"
                   GridPane.rowIndex="6" GridPane.columnSpan="2"/>
        </GridPane>
    </content>
</DialogPane>
