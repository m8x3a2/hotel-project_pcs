<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!--
    Главное окно. fx:controller - какой класс управляет этим окном.
    stylesheets="@app.css" - подключаем стили (файл лежит рядом).
    Каждая вкладка подключается из отдельного FXML через fx:include.
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.hotel.fx.controller.MainController"
            stylesheets="@app.css">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Label text="Гостиница" styleClass="header-title"/>
            <Label text="бронирование номеров" styleClass="header-subtitle"/>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="bookingsTab" text="Бронирования">
                <fx:include fx:id="bookingsView" source="bookings-tab.fxml"/>
            </Tab>
            <Tab fx:id="guestsTab" text="Гости">
                <fx:include fx:id="guestsView" source="guests-tab.fxml"/>
            </Tab>
            <Tab fx:id="roomsTab" text="Номера">
                <fx:include fx:id="roomsView" source="rooms-tab.fxml"/>
            </Tab>
            <Tab fx:id="statisticsTab" text="Статистика">
                <fx:include fx:id="statisticsView" source="statistics-tab.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
